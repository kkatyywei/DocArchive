<Window x:Class="UDocStoreApp.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="Карточка документа" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="CustomCalendarDayButtonStyle" TargetType="CalendarDayButton" BasedOn="{StaticResource MaterialDesignCalendarDayButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#673AB7"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Grid>
                                <Ellipse x:Name="BackgroundEllipse" Fill="Transparent" Margin="2"/>
                                <Ellipse x:Name="SelectedEllipse" Fill="#673AB7" Opacity="0" Margin="2"/>
                                <ContentPresenter x:Name="ContentPresenter"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Content="{TemplateBinding Content}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#E1BEE7"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#E1BEE7"/>
                                    <Setter Property="Foreground" Value="#673AB7"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectedEllipse" Property="Fill" Value="#673AB7"/>
                                    <Setter TargetName="SelectedEllipse" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="LightGray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CustomCalendarItemStyle" TargetType="CalendarItem">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="CustomCalendarStyle" TargetType="Calendar" BasedOn="{StaticResource MaterialDesignCalendarPortrait}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CalendarItemStyle" Value="{StaticResource CustomCalendarItemStyle}"/>
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CustomCalendarDayButtonStyle}"/>
            </Style>

            <Style x:Key="CustomDatePickerStyle" TargetType="DatePicker">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Visible"/>
                <Setter Property="CalendarStyle" Value="{StaticResource CustomCalendarStyle}"/>
                
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="TextBox"
                                    Grid.Column="0"
                                    Text="{TemplateBinding Text}" 
                                    Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                                <Button x:Name="PART_Button"
                                     Grid.Column="1"
                                     Focusable="False"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0">  
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <materialDesign:PackIcon Kind="Calendar" Width="20" Height="20" Foreground="{DynamicResource MaterialDesignBody}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup" Placement="Bottom"  AllowsTransparency="True"
                                    IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" PlacementTarget="{Binding ElementName=PART_TextBox}"
                                    StaysOpen="False" />    
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True">
            <StackPanel Cursor="">
                <!-- short text-->
                <materialDesign:Card Padding="15" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="СОДЕРЖАНИЕ ДОКУМЕНТА" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBox Text="{Binding CurrentOrder.Text}" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="100" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalContentAlignment="Top"
                                 materialDesign:HintAssist.Hint="Введите краткое содержание или описание документа..."
                                 IsEnabled="{Binding CanEditDocument}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- numbs/dates -->
                <materialDesign:Card Padding="15" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="РЕКВИЗИТЫ" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,0">
                                <TextBox Text="{Binding CurrentOrder.NumberReg}" 
                                         materialDesign:HintAssist.Hint="Регистрационный №"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         IsReadOnly="True" Margin="0,0,0,15"/>

                                <TextBox Text="{Binding CurrentOrder.NumberOrder}" 
                                         materialDesign:HintAssist.Hint="Входящий / Исходящий №"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         IsEnabled="{Binding CanEditDocument}"/>
                            </StackPanel>
                            <StackPanel>
                                <DatePicker SelectedDate="{Binding CurrentOrder.DateOrder}" 
                                            materialDesign:HintAssist.Hint="Дата документа" 
                                            Style="{StaticResource CustomDatePickerStyle}" materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                                            IsEnabled="{Binding CanEditDocument}" Margin="0,0,0,15" CalendarOpened="DatePicker_CalendarOpened" CalendarClosed="DatePicker_CalendarClosed"/>
                              
                                <TextBox Text="{Binding CurrentOrder.RegDate, StringFormat=dd.MM.yyyy HH:mm}" 
                                         materialDesign:HintAssist.Hint="Дата регистрации в системе"
                                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                         IsReadOnly="True"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- executors -->
                <materialDesign:Card Padding="15" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="ОТВЕТСТВЕННЫЕ ИСПОЛНИТЕЛИ" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <Grid Height="150">
                            <!-- admin/reg -->
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Visibility="{Binding AdminPanelVisibility}">
                                <ListBox ItemsSource="{Binding AllExecutorsSelection}" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding FIO}" 
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  IsEnabled="{Binding DataContext.CanEditDocument, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource MaterialDesignCheckBox}"
                                                  Foreground="{DynamicResource MaterialDesignBody}"
                                                  Margin="10,5"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!--readonly exec/nabl -->
                            <Border Background="{DynamicResource MaterialDesignSelection}" CornerRadius="4" Visibility="{Binding ReadPanelVisibility}">
                                <ListBox ItemsSource="{Binding AssignedExecutors}" DisplayMemberPath="FIO" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- files -->
                <materialDesign:Card Padding="15" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ПРИКРЕПЛЕННЫЕ ФАЙЛЫ" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <ListBox ItemsSource="{Binding Files}" 
                                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}" 
                                 Height="120" Margin="0,0,0,15"
                                 Style="{StaticResource MaterialDesignListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileOutline" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid Columns="3" Height="45">
                            <Button Command="{Binding AddFileCommand}" 
                                    Visibility="{Binding AdminPanelVisibility}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,5,0">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,5,0" />
                                        <TextBlock Text="ДОБАВИТЬ"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button Command="{Binding DeleteFileCommand}" 
                                    Visibility="{Binding AdminPanelVisibility}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Margin="0,0,5,0">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Margin="0,0,5,0" />
                                        <TextBlock Text="УДАЛИТЬ"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button Command="{Binding DownloadSelectedFileCommand}" 
                                    Style="{StaticResource MaterialDesignRaisedSecondaryButton}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Download" Margin="0,0,5,0" />
                                        <TextBlock Text="СКАЧАТЬ"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- buttons -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveCommand}" 
                            Visibility="{Binding SaveBtnVisibility}"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#10B981" BorderBrush="#10B981" Width="150" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="СОХРАНИТЬ"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RestoreCommand}" 
                            Visibility="{Binding RestoreBtnVisibility}"
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Background="#F59E0B" BorderBrush="#F59E0B" Width="180" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restore" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ВОССТАНОВИТЬ"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>