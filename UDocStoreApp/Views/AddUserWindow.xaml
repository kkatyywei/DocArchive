<Window x:Class="UDocStoreApp.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        mc:Ignorable="d"
        Title="Новый пользователь" Height="392" Width="400" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="ФИО:"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,10"/>

        <TextBlock Text="Должность:"/>
        <TextBox x:Name="DolBox" Margin="0,5,0,10"/>
        
        <TextBlock Text="Логин:"/>
        <TextBox x:Name="LoginBox" Margin="0,5,0,10"/>

        <TextBlock Text="Временный пароль:"/>
        <PasswordBox x:Name="PassBox" Margin="0,5,0,10"/>

        <TextBlock Text="Роль:"/>
        <ComboBox x:Name="RoleCombo" DisplayMemberPath="Name" SelectedValuePath="id" Margin="0,5,0,15"/>

        <CheckBox x:Name="ForceChangeCheck" Content="Потребовать смену пароля при входе" IsChecked="True" Margin="0,0,0,20"/>

        <UniformGrid Columns="2">
            <Button Content="Создать" Click="Create_Click" Height="30" Background="#10B981" Foreground="White" Margin="0,0,5,0"/>
            <Button Content="Отмена" IsCancel="True" Height="30"/>
        </UniformGrid>
    </StackPanel>
</Window>
