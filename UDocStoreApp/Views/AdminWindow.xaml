<Window x:Class="UDocStoreApp.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        mc:Ignorable="d"
        Title="Панель администратора" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid>
        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp4" Margin="15" materialDesign:UniformCornerRadius="12">
            <TabControl Style="{StaticResource MaterialDesignTabControl}" materialDesign:ColorZoneAssist.Mode="PrimaryMid">

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="ПОЛЬЗОВАТЕЛИ" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" 
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  materialDesign:DataGridAssist.CellPadding="8"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="ФИО Пользователя" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Роль" Binding="{Binding Right.Name}" Width="150"/>
                                <DataGridCheckBoxColumn Header="Активен" 
                                                        Binding="{Binding Active, Converter={StaticResource IntToBoolConverter}}" 
                                                        Width="80"
                                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button Content="ДОБАВИТЬ" Command="{Binding AddUserCommand}" 
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="5" Width="120"/>
                            <Button Content="РЕДАКТИРОВАТЬ" Command="{Binding EditUserCommand}" 
                                    Style="{StaticResource MaterialDesignFlatButton}" Margin="5" Width="150"/>
                            <Button Content="БЛОКИРОВАТЬ" Command="{Binding BlockUserCommand}" 
                                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="5" Width="140"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldLock" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="БЕЗОПАСНОСТЬ" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer Margin="20">
                        <materialDesign:Card Padding="30" MaxWidth="800" materialDesign:ElevationAssist.Elevation="Dp1" Width="427" HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="ПОЛИТИКА ПАРОЛЕЙ" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                                <CheckBox Content="Требовать сложные символы (A-z, 0-9, @#$)" IsChecked="{Binding Policy.Strength}" Margin="0,5"/>

                                <Separator Margin="0,15" Opacity="0.2"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <CheckBox IsChecked="{Binding Policy.MinWidthCheck}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Минимальная длина:" VerticalAlignment="Center" Margin="10,0" Width="250"/>
                                    <TextBox Text="{Binding Policy.MinWidth}" Width="50" IsEnabled="{Binding Policy.MinWidthCheck}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <CheckBox IsChecked="{Binding Policy.MaxPeriodCheck}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Максимальный срок действия (дн.):" VerticalAlignment="Center" Margin="10,0" Width="250"/>
                                    <TextBox Text="{Binding Policy.MaxPeriod}" Width="50" IsEnabled="{Binding Policy.MaxPeriodCheck}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <CheckBox IsChecked="{Binding Policy.MinPeriodCheck}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Мин. срок действия (дн.):" VerticalAlignment="Center" Margin="10,0" Width="250"/>
                                    <TextBox Text="{Binding Policy.MinPeriod}" Width="50" IsEnabled="{Binding Policy.MinPeriodCheck}" TextAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10">
                                    <CheckBox IsChecked="{Binding Policy.CountLastCheck}" VerticalAlignment="Center"/>
                                    <TextBlock Text="История паролей (кол-во):" VerticalAlignment="Center" Margin="10,0" Width="250"/>
                                    <TextBox Text="{Binding Policy.CountLast}" Width="50" IsEnabled="{Binding Policy.CountLastCheck}" TextAlignment="Center"/>
                                </StackPanel>

                                <Button Content="ПРИМЕНИТЬ НАСТРОЙКИ" Command="{Binding SavePolicyCommand}" 
                                        Height="45" Margin="0,30,0,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sitemap" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="СТРУКТУРА" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card Grid.Column="0" Margin="5" Padding="10" materialDesign:ElevationAssist.Elevation="Dp8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="РАЗДЕЛЫ" FontWeight="Bold" Margin="5" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" 
                                         DisplayMemberPath="SectionName" Style="{StaticResource MaterialDesignListBox}" Margin="0,10"/>
                                <UniformGrid Grid.Row="2" Columns="2">
                                    <Button Content="ДОБАВИТЬ" Command="{Binding AddSectionCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
                                    <Button Content="УДАЛИТЬ" Command="{Binding DeleteSectionCommand}" Foreground="Red" Style="{StaticResource MaterialDesignFlatButton}"/>
                                </UniformGrid>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Column="1" Margin="5" Padding="10" materialDesign:ElevationAssist.Elevation="Dp8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="ЖУРНАЛЫ В РАЗДЕЛЕ" FontWeight="Bold" Margin="5" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedSection.Catalogs}" SelectedItem="{Binding SelectedCatalog}" 
                                         DisplayMemberPath="CatalogName" Style="{StaticResource MaterialDesignListBox}" Margin="0,10"/>
                                <UniformGrid Grid.Row="2" Columns="2">
                                    <Button Content="ДОБАВИТЬ" Command="{Binding AddCatalogCommand}" Style="{StaticResource MaterialDesignFlatButton}"/>
                                    <Button Content="УДАЛИТЬ" Command="{Binding DeleteCatalogCommand}" Foreground="Red" Style="{StaticResource MaterialDesignFlatButton}"/>
                                </UniformGrid>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountTie" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="ИСПОЛНИТЕЛИ" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:Card Grid.Column="0" Padding="10">
                            <DockPanel>
                                <TextBlock Text="ВЫБОР ПОЛЬЗОВАТЕЛЯ" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUserForExecutor}" DisplayMemberPath="Name"/>
                            </DockPanel>
                        </materialDesign:Card>

                        <Button Grid.Column="1" Command="{Binding MakeExecutorCommand}" 
                                Style="{StaticResource MaterialDesignFloatingActionMiniSecondaryButton}" 
                                VerticalAlignment="Center" Margin="15" ToolTip="Назначить исполнителем">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24" />
                        </Button>

                        <materialDesign:Card Grid.Column="2" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="СПРАВОЧНИК ИСПОЛНИТЕЛЕЙ" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Executors}" SelectedItem="{Binding SelectedExecutor}" 
                                          AutoGenerateColumns="False" Style="{StaticResource MaterialDesignDataGrid}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                                        <DataGridTemplateColumn Header="Акт." Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Active, Converter={StaticResource IntToBoolConverter}, Mode=OneWay}"
                                                              Command="{Binding DataContext.ToggleExecutorActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Cursor="">
                                    <Button Content="УДАЛИТЬ" Command="{Binding DeleteExecutorCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red" Margin="0,10,0,0"/>
                                    <Button Content="Разблокировать" Command="{Binding UnlockExecutorCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="Green" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</Window>
