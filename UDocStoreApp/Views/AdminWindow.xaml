<Window x:Class="UDocStoreApp.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        mc:Ignorable="d"
        Title="Панель администратора" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <TabControl>
            <!-- УПРАВЛЕНИЕ ПОЛЬЗОВАТЕЛЯМИ -->
            <TabItem Header="Пользователи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Users}"  SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Right.Name}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Активен" 
                                Binding="{Binding Active, Converter={StaticResource IntToBoolConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                        <Button Content="Добавить" Command="{Binding AddUserCommand}" Width="80" Margin="5"/>
                        <Button Content="Редактировать" Command="{Binding EditUserCommand}" Width="100" Margin="5" Background="#3B82F6" Foreground="White"/>
                        <Button Content="Блокировать / Разбл." Command="{Binding BlockUserCommand}" Width="150" Margin="5" Background="#F59E0B" Foreground="White"/>
                        <Button Content="💾 Сохранить все изменения" 
 Command="{Binding SaveChangesCommand}" 
 Height="40" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="5"/>
                    </StackPanel>
                    
                </Grid>
            </TabItem>
           
            <!-- ПОЛИТИКА ПАРОЛЕЙ -->
            <TabItem Header="Безопасность">
                <ScrollViewer Margin="20">
                    <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="Настройки безопасности" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <!-- Сложность -->
                        <CheckBox Content="Требовать сложный пароль" 
                      IsChecked="{Binding Policy.Strength}" Margin="0,5"/>
                        <TextBlock Text="(минимум: 1 заглавная, 1 строчная, 1 цифра, 1 спецсимвол)" 
                       Foreground="Gray" FontSize="11" Margin="25,0,0,10"/>

                        <!-- Длина -->
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <CheckBox Content="Минимальная длина:" IsChecked="{Binding Policy.MinWidthCheck}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Policy.MinWidth}" Width="50" Margin="10,0" IsEnabled="{Binding Policy.MinWidthCheck}"/>
                            <TextBlock Text="символов" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <!-- Макс срок -->
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <CheckBox Content="Максимальный срок действия:" IsChecked="{Binding Policy.MaxPeriodCheck}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Policy.MaxPeriod}" Width="50" Margin="10,0" IsEnabled="{Binding Policy.MaxPeriodCheck}"/>
                            <TextBlock Text="дней (заставит сменить пароль)" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <!-- Мин срок -->
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <CheckBox Content="Мининмальный срок действия:" IsChecked="{Binding Policy.MinPeriodCheck}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Policy.MinPeriod}" Width="50" Margin="10,0" IsEnabled="{Binding Policy.MinPeriodCheck}"/>
                            <TextBlock Text="дней (нельзя менять чаще этого)" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <!-- История -->
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <CheckBox Content="Запретить повтор последних:" IsChecked="{Binding Policy.CountLastCheck}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Policy.CountLast}" Width="50" Margin="10,0" IsEnabled="{Binding Policy.CountLastCheck}"/>
                            <TextBlock Text="паролей" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <Button Content="ПРИМЕНИТЬ ПОЛИТИКУ" Command="{Binding SavePolicyCommand}" 
                    Height="40" Margin="0,20,0,0" Background="#10B981" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Структура архива">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Лево: РАЗДЕЛЫ -->
                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Разделы архива" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" 
                     DisplayMemberPath="SectionName" Height="300" Margin="0,5"/>
                        <Button Content="+ Добавить раздел" Command="{Binding AddSectionCommand}" Height="30" Background="#10B981" Foreground="White"/>
                        <Button Content="Удалить раздел" Command="{Binding DeleteSectionCommand}" Margin="0,5" Background="#EF4444" Foreground="White"/>
                    </StackPanel>

                    <!-- Право: ЖУРНАЛЫ -->
                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Журналы в выбранном разделе" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding SelectedSection.Catalogs}" DisplayMemberPath="CatalogName" Height="300" Margin="0,5"/>
                        <Button Content="+ Добавить журнал" Command="{Binding AddCatalogCommand}" Height="30" Background="#3B82F6" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Добавь это в TabControl внутри AdminWindow.xaml -->
            <TabItem Header="Исполнители">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Список пользователей -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Кнопка переноса -->
                        <ColumnDefinition Width="*"/>
                        <!-- Список исполнителей -->
                    </Grid.ColumnDefinitions>

                    <!-- ЛЕВО: Все пользователи -->
                    <GroupBox Header="Пользователи системы" Grid.Column="0" Margin="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUserForExecutor}" DisplayMemberPath="Name" Margin="5"/>
                            <TextBlock Text="Выберите пользователя для назначения" Grid.Row="1" HorizontalAlignment="Center" Foreground="Gray" FontSize="10"/>
                        </Grid>
                    </GroupBox>

                    <!-- ЦЕНТР: Кнопка -->
                    <Button Grid.Column="1" Content="➔ Назначить" Command="{Binding MakeExecutorCommand}" 
                VerticalAlignment="Center" Margin="10" Padding="10,5" Background="#10B981" Foreground="White"/>

                    <!-- ПРАВО: Справочник исполнителей -->
                    <GroupBox Header="Справочник исполнителей" Grid.Column="2" Margin="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding Executors}" SelectedItem="{Binding SelectedExecutor}" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                                    <DataGridTextColumn Header="Должность" Binding="{Binding Dol}" Width="100"/>
                                    <DataGridCheckBoxColumn Header="Активен" 
                                Binding="{Binding Active, Converter={StaticResource IntToBoolConverter}, UpdateSourceTrigger=PropertyChanged}" 
                                Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Удалить из справочника" Command="{Binding DeleteExecutorCommand}" 
                        Grid.Row="1" Margin="5" Background="#EF4444" Foreground="White"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
