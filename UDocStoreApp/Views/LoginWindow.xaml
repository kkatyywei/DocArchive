<Window x:Class="UDocStoreApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        xmlns:infra="clr-namespace:UDocStoreApp.Infrastructure"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="Авторизация" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
        <materialDesign:Card Width="380" Padding="30" 
                         materialDesign:ElevationAssist.Elevation="Dp6" 
                         VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                     <Image Source="pack://application:,,,/Resources/appicon.png" Width="38" Margin="10,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="UDocStore" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                </StackPanel>
           
                <TextBox 
                    x:Name="NameTextBox"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    materialDesign:HintAssist.Hint="Логин"
                    Margin="0,10">
                    <TextBox.Text>
                        <Binding Path="Login" 
                         UpdateSourceTrigger="PropertyChanged" 
                         ValidatesOnDataErrors="True">
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <PasswordBox materialDesign:HintAssist.Hint="Пароль" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" 
                             infra:PasswordHelper.Attach="True" 
                             infra:PasswordHelper.Password="{Binding Password, Mode=TwoWay}" Margin="0,10"/>

                <Button Content="ВОЙТИ" IsDefault="True" Command="{Binding LoginCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}" 
                        Margin="0,20,0,0" Height="45" materialDesign:ButtonAssist.CornerRadius="10"/>
                </StackPanel>
        </materialDesign:Card>
</Window>
