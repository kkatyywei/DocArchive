<Window x:Class="UDocStoreApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        xmlns:models="clr-namespace:UDocStoreApp.Models" 
        xmlns:infra="clr-namespace:UDocStoreApp.Infrastructure"
        mc:Ignorable="d"
        Title="UDocStore - Электронный архив" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Объявляем конвертер локально в окне -->
        <infra:AdminVisibilityConverter x:Key="AdminVisibilityConverter"/>
    </Window.Resources>
    
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <DockPanel Margin="15,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Архив документов" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                    <Border Background="#DBEAFE" CornerRadius="10" Margin="15,0" Padding="10,2">
                        <TextBlock Text="{Binding CurrentUser.Name}" Foreground="#1E40AF" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Поиск: " VerticalAlignment="Center" Foreground="Gray" Margin="0,0,5,0"/>
                    <TextBox Width="250" Height="30" Margin="0,0,10,0" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center" Padding="5,0" 
                             ToolTip="Поиск по названию, номеру или исполнителю"/>
                    
                    <Button Content="Выйти" Click="Logout_Click" 
            Padding="10,5" Background="#94a3b8" Foreground="White" Margin="0,0,10,0"/>

                    <!-- Кнопка админа (пока без конвертера, просто кнопка) -->
                    <Button x:Name="AdminButton" 
                        Content="Админ-панель" 
                        Click="AdminBtn_Click" 
                        Padding="15,5" 
                        Background="#374151" 
                        Foreground="White"/>
                </StackPanel>
                
                
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ (ДЕРЕВО) - ДОБАВИЛИ x:Name -->
            <TreeView x:Name="ArchiveTree" Grid.Column="0" ItemsSource="{Binding Sections}" Margin="5">
                <TreeView.Resources>
                    <!-- Темплейт для Секции (папка) -->
                    <HierarchicalDataTemplate DataType="{x:Type models:Section}" ItemsSource="{Binding Catalogs}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="📁 " Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding SectionName}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>

                    <!-- Темплейт для Каталога (лист) -->
                    <DataTemplate DataType="{x:Type models:Catalog}">
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="📄 " Foreground="#6B7280"/>
                            <TextBlock Text="{Binding CatalogName}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E7EB"/>

            <!-- ПРАВАЯ ПАНЕЛЬ (ТАБЛИЦА) -->
            <Grid Grid.Column="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Панель кнопок -->
                    <RowDefinition Height="*"/>
                    <!-- Таблица -->
                </Grid.RowDefinitions>

                <!-- ПАНЕЛЬ ИНСТРУМЕНТОВ -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="➕ Создать документ" Command="{Binding AddOrderCommand}" 
                Padding="10,5" Background="#10B981" Foreground="White" Margin="0,0,5,0"/>

                    <Button Content="📝 Редактировать" Click="EditOrder_Click" 
                Padding="10,5" Margin="0,0,5,0"/>

                    <Button Content="🗑 Удалить" Command="{Binding DeleteOrderCommand}" 
                Padding="10,5" Background="#EF4444" Foreground="White"/>
                </StackPanel>

                <!-- ТАБЛИЦА (Убедись, что x:Name="OrdersTable") -->
                <DataGrid x:Name="OrdersTable" Grid.Row="1" 
              ItemsSource="{Binding Orders}" 
              SelectedItem="{Binding SelectedOrder}"
              AutoGenerateColumns="False" 
              IsReadOnly="True" GridLinesVisibility="None" Background="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№ Рег" Binding="{Binding NumberReg}" Width="70"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateOrder, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Номер" Binding="{Binding NumberOrder}" Width="120"/>
                        <DataGridTextColumn Header="Содержание" Binding="{Binding Text}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

        </Grid>
    </Grid>
</Window>
