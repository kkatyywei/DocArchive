<Window x:Class="UDocStoreApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        xmlns:models="clr-namespace:UDocStoreApp.Models" 
        xmlns:infra="clr-namespace:UDocStoreApp.Infrastructure"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="UDocStore - Электронный архив" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 1. Стиль кнопки дня -->
            <Style x:Key="CustomCalendarDayButtonStyle" TargetType="CalendarDayButton" BasedOn="{StaticResource MaterialDesignCalendarDayButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#673AB7"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Grid>
                                <Ellipse x:Name="BackgroundEllipse" Fill="Transparent" Margin="2"/>
                                <Ellipse x:Name="SelectedEllipse" Fill="#673AB7" Opacity="0" Margin="2"/>
                                <ContentPresenter x:Name="ContentPresenter"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#E1BEE7"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BackgroundEllipse" Property="Fill" Value="#E1BEE7"/>
                                    <Setter Property="Foreground" Value="#673AB7"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="SelectedEllipse" Property="Fill" Value="#673AB7"/>
                                    <Setter TargetName="SelectedEllipse" Property="Opacity" Value="1"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="LightGray"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 2. Стиль элемента CalendarItem (без BasedOn, чтобы не искать отсутствующий ресурс) -->
            <Style x:Key="CustomCalendarItemStyle" TargetType="CalendarItem">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- 3. Основной стиль календаря -->
            <Style x:Key="CustomCalendarStyle" TargetType="Calendar" BasedOn="{StaticResource MaterialDesignCalendarPortrait}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CalendarItemStyle" Value="{StaticResource CustomCalendarItemStyle}"/>
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CustomCalendarDayButtonStyle}"/>
            </Style>

            <!-- 4. Стиль DatePicker для исправления исчезающей иконки -->
            <Style x:Key="CustomDatePickerStyle" TargetType="DatePicker">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0,0,0"/>
                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Visible"/>
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="White"/>
                <Setter Property="CalendarStyle" Value="{StaticResource CustomCalendarStyle}"/>

                <!-- Шаблон, который корректно отображает иконку календаря -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Поле для ввода даты -->
                                <DatePickerTextBox x:Name="TextBox"
                                       Grid.Column="0"
                                       Text="{TemplateBinding Text}" BorderBrush="White" materialDesign:TextFieldAssist.UnderlineBrush="White"
                                       Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                                <!-- Кнопка для вызова календаря -->
                                <Button x:Name="PART_Button"
                            Grid.Column="1"
                            Focusable="False"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <materialDesign:PackIcon Kind="Calendar"
                                                              Width="20"
                                                              Height="20"
                                                              Foreground="White" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Выпадающее окно календаря -->
                                <Popup x:Name="PART_Popup" Placement="Bottom"  AllowsTransparency="True"
IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" PlacementTarget="{Binding ElementName=PART_TextBox}"
StaysOpen="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Современная шапка -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ (ColorZone) -->
        <materialDesign:ColorZone Grid.Row="0"  Mode="PrimaryMid" Padding="12" materialDesign:ElevationAssist.Elevation="Dp3">
            <DockPanel>
                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="5,0">
                    <Image Source="pack://application:,,,/Resources/blackicon.png" Width="45" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="U-DOC STORE" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Блок пользователя и Выход -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0">
                    <materialDesign:PackIcon Kind="Account" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ShortName}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0" materialDesign:TextFieldAssist.UnderlineBrush="White"/>
                    <Button Content="ВЫЙТИ" Click="Logout_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"/>
                </StackPanel>

                <!-- Глобальный поиск и фильтры в шапке -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp0" 
                                     Background="{DynamicResource PrimaryHueLightBrush}" 
                                     Margin="20,0" VerticalAlignment="Center" 
                                     materialDesign:UniformCornerRadius="8" Padding="5,2" Width="Auto">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="200" materialDesign:HintAssist.Hint="Поиск..." FontSize="15" 
                                 materialDesign:TextFieldAssist.DecorationVisibility="Visible"
                                 BorderThickness="0,0,0,1" BorderBrush="White"  materialDesign:TextFieldAssist.UnderlineBrush="White" VerticalAlignment="Center" Height="34"/>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" Background="White" Opacity="0.3"/>

                        <TextBlock Text="С:" VerticalAlignment="Center" FontSize="14" Margin="5,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="105" VerticalContentAlignment="Center" Padding="10,0,0,0"  FontSize="15"    Style="{StaticResource CustomDatePickerStyle}"
                                    materialDesign:TextFieldAssist.DecorationVisibility="Visible"  CalendarStyle="{StaticResource CustomCalendarStyle}"/>

                        <TextBlock Text="ПО:" VerticalAlignment="Center" FontSize="14" Margin="20,0,0,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="105"   Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="10,0,0,0"  FontSize="15"  Style="{StaticResource CustomDatePickerStyle}"
                                    materialDesign:TextFieldAssist.DecorationVisibility="Visible"  BorderThickness="0,0,0,1" BorderBrush="White" materialDesign:TextFieldAssist.UnderlineBrush="White" CalendarStyle="{StaticResource CustomCalendarStyle}"/>

                        <Button Command="{Binding ClearFiltersCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                Padding="2" Width="30" Height="30" Foreground="Red" ToolTip="Сбросить фильтры">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Height="20" Width="20"/>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </DockPanel>
        </materialDesign:ColorZone>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <!-- Дерево -->
                <ColumnDefinition Width="15"/>
                <!-- Отступ -->
                <ColumnDefinition Width="*"/>
                <!-- Контент -->
            </Grid.ColumnDefinitions>

            <!-- 2. ЛЕВАЯ ПАНЕЛЬ: ДЕРЕВО -->
            <materialDesign:Card Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp1" materialDesign:UniformCornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PrimaryHueLightBrush}" Padding="15,10" CornerRadius="10,10,0,0">
                        <TextBlock Text="НАВИГАЦИЯ" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </Border>

                    <TreeView x:Name="ArchiveTree" Grid.Row="1" ItemsSource="{Binding Sections}" Margin="5">
                        <TreeView.Resources>
                            <!-- Секция -->
                            <HierarchicalDataTemplate DataType="{x:Type models:Section}" ItemsSource="{Binding Catalogs}">
                                <StackPanel Orientation="Horizontal" Margin="2,4">
                                    <materialDesign:PackIcon Kind="Folder" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SectionName}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <!-- Журнал -->
                            <DataTemplate DataType="{x:Type models:Catalog}">
                                <StackPanel Orientation="Horizontal" Margin="2,4">
                                    <materialDesign:PackIcon Kind="FileCabinet" Foreground="Gray" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CatalogName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <!-- 3. ПРАВАЯ ПАНЕЛЬ: ВКЛАДКИ -->
            <materialDesign:Card Grid.Column="2" materialDesign:ElevationAssist.Elevation="Dp2" materialDesign:UniformCornerRadius="10">
                <TabControl Style="{StaticResource MaterialDesignTabControl}" 
                materialDesign:ColorZoneAssist.Mode="Standard">

                    <!-- ВКЛАДКА 1: АРХИВ -->
                    <TabItem Header="АРХИВ ДОКУМЕНТОВ">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Панель кнопок (Документ, Журнал, Редактировать) -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,15">
                                <Button Command="{Binding AddOrderCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}"
                            Padding="15,0" Margin="0,0,10,0" Height="35" materialDesign:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ДОКУМЕНТ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding AddCatalogCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}"
                            Margin="0,0,10,0" Height="35" materialDesign:ButtonAssist.CornerRadius="6" ToolTip="Новый журнал">
                                    <materialDesign:PackIcon Kind="FolderPlusOutline" />
                                </Button>

                                <Button Click="EditOrder_Click" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}"
                            Margin="0,0,10,0" Height="35">
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </Button>

                                <Button Command="{Binding DeleteOrderCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red"
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource AdminVisibilityConverter}}"
                            Height="35">
                                    <materialDesign:PackIcon Kind="DeleteOutline" />
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" />

                                <Button x:Name="AdminButton" Content="АДМИН-ПАНЕЛЬ" Click="AdminBtn_Click" 
                                         Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                                        Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource AdminVisibilityConverter}}"
                                    Height="35" materialDesign:ButtonAssist.CornerRadius="6"/>  
                            </StackPanel>

                            <!-- Таблица документов -->
                            <DataGrid x:Name="OrdersTable" Grid.Row="1" 
                              ItemsSource="{Binding Orders}" 
                              SelectedItem="{Binding SelectedOrder}"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="10"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="20,10,10,10">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding idUser, Converter={StaticResource IsAuthorConverter}}" Value="True">
                                                <Setter Property="Background" Value="#F0F4FF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding isDel}" Value="1">
                                                <Setter Property="Foreground" Value="Silver"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№ Рег" Binding="{Binding NumberReg}" Width="80" />
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateOrder, StringFormat=dd.MM.yyyy}" Width="110"/>
                                    <DataGridTextColumn Header="Номер" Binding="{Binding NumberOrder}" Width="130"/>
                                    <DataGridTextColumn Header="Содержание" Binding="{Binding Text}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ВКЛАДКА 2: ИСПОЛНИТЕЛИ -->
                    <TabItem Header="СПРАВОЧНИК ИСПОЛНИТЕЛЕЙ" 
                 Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock Text="ОТВЕТСТВЕННЫЕ ЛИЦА" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="Список сотрудников, назначенных исполнителями по документам" FontSize="12" Foreground="Gray"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding AllExecutors}" 
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HorizontalAlignment="Center"
                                      materialDesign:DataGridAssist.CellPadding="10">   
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                                    <DataGridTextColumn Header="Должность" Binding="{Binding Dol}" Width="250"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
