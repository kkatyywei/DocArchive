<Window x:Class="UDocStoreApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        xmlns:models="clr-namespace:UDocStoreApp.Models" 
        xmlns:infra="clr-namespace:UDocStoreApp.Infrastructure"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="UDocStore - Электронный архив" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Современная шапка -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ (ColorZone) -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="12" materialDesign:ElevationAssist.Elevation="Dp3">
            <DockPanel>
                <!-- Логотип -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="10,0">
                    <materialDesign:PackIcon Kind="FolderZip" Width="28" Height="28" VerticalAlignment="Center"/>
                    <TextBlock Text="U-DOC STORE" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Блок пользователя и Выход -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0">
                    <materialDesign:PackIcon Kind="Account" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding CurrentUser.Name}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,15,0"/>
                    <Button Content="ВЫЙТИ" Click="Logout_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White"/>
                </StackPanel>

                <!-- Глобальный поиск и фильтры в шапке -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp0" 
                                     Background="{DynamicResource PrimaryHueLightBrush}" 
                                     Margin="40,0" VerticalAlignment="Center" 
                                     materialDesign:UniformCornerRadius="8" Padding="5,2">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Margin="10,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="200" materialDesign:HintAssist.Hint="Поиск..." FontSize="15"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                 BorderThickness="0,0,0,1" BorderBrush="White" VerticalAlignment="Center" Height="29"/>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" Background="White" Opacity="0.3"/>

                        <TextBlock Text="С:" VerticalAlignment="Center" FontSize="14" Margin="5,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="105" VerticalContentAlignment="Center" Padding="10,0,0,0"  FontSize="15"
                                    materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0,0,0,1" BorderBrush="White"/>

                        <TextBlock Text="ПО:" VerticalAlignment="Center" FontSize="14" Margin="20,0,0,0"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Width="105"   Margin="0,0,10,0" VerticalContentAlignment="Center" Padding="10,0,0,0"  FontSize="15"
                                    materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"  BorderThickness="0,0,0,1" BorderBrush="White"/>

                        <Button Command="{Binding ClearFiltersCommand}" Style="{StaticResource MaterialDesignFlatButton}" 
                                Padding="2" Width="30" Height="30" Foreground="Red" ToolTip="Сбросить фильтры">
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Height="20" Width="20"/>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </DockPanel>
        </materialDesign:ColorZone>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <!-- Дерево -->
                <ColumnDefinition Width="15"/>
                <!-- Отступ -->
                <ColumnDefinition Width="*"/>
                <!-- Контент -->
            </Grid.ColumnDefinitions>

            <!-- 2. ЛЕВАЯ ПАНЕЛЬ: ДЕРЕВО -->
            <materialDesign:Card Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp1" materialDesign:UniformCornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PrimaryHueLightBrush}" Padding="15,10" CornerRadius="10,10,0,0">
                        <TextBlock Text="НАВИГАЦИЯ" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </Border>

                    <TreeView x:Name="ArchiveTree" Grid.Row="1" ItemsSource="{Binding Sections}" Margin="5">
                        <TreeView.Resources>
                            <!-- Секция -->
                            <HierarchicalDataTemplate DataType="{x:Type models:Section}" ItemsSource="{Binding Catalogs}">
                                <StackPanel Orientation="Horizontal" Margin="2,4">
                                    <materialDesign:PackIcon Kind="Folder" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding SectionName}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <!-- Журнал -->
                            <DataTemplate DataType="{x:Type models:Catalog}">
                                <StackPanel Orientation="Horizontal" Margin="2,4">
                                    <materialDesign:PackIcon Kind="FileCabinet" Foreground="Gray" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CatalogName}"/>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </materialDesign:Card>

            <!-- 3. ПРАВАЯ ПАНЕЛЬ: ВКЛАДКИ -->
            <materialDesign:Card Grid.Column="2" materialDesign:ElevationAssist.Elevation="Dp2" materialDesign:UniformCornerRadius="10">
                <TabControl Style="{StaticResource MaterialDesignTabControl}" 
                materialDesign:ColorZoneAssist.Mode="Standard">

                    <!-- ВКЛАДКА 1: АРХИВ -->
                    <TabItem Header="АРХИВ ДОКУМЕНТОВ">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Панель кнопок (Документ, Журнал, Редактировать) -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,15">
                                <Button Command="{Binding AddOrderCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}"
                            Padding="15,0" Margin="0,0,10,0" Height="35" materialDesign:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ДОКУМЕНТ" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding AddCatalogCommand}" 
                            Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}"
                            Margin="0,0,10,0" Height="35" materialDesign:ButtonAssist.CornerRadius="6" ToolTip="Новый журнал">
                                    <materialDesign:PackIcon Kind="FolderPlusOutline" />
                                </Button>

                                <Button Click="EditOrder_Click" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}"
                            Margin="0,0,10,0" Height="35">
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </Button>

                                <Button Command="{Binding DeleteOrderCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="Red"
                            Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource AdminVisibilityConverter}}"
                            Height="35">
                                    <materialDesign:PackIcon Kind="DeleteOutline" />
                                </Button>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0" />

                                <Button x:Name="AdminButton" Content="АДМИН-ПАНЕЛЬ" Click="AdminBtn_Click" 
                                         Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                                        Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource AdminVisibilityConverter}}"
                                    Height="35" materialDesign:ButtonAssist.CornerRadius="6"/>  
                            </StackPanel>

                            <!-- Таблица документов -->
                            <DataGrid x:Name="OrdersTable" Grid.Row="1" 
                              ItemsSource="{Binding Orders}" 
                              SelectedItem="{Binding SelectedOrder}"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="10"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding idUser, Converter={StaticResource IsAuthorConverter}}" Value="True">
                                                <Setter Property="Background" Value="#F0F4FF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding isDel}" Value="1">
                                                <Setter Property="Foreground" Value="Silver"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№ Рег" Binding="{Binding NumberReg}" Width="80"/>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding DateOrder, StringFormat=dd.MM.yyyy}" Width="110"/>
                                    <DataGridTextColumn Header="Номер" Binding="{Binding NumberOrder}" Width="130"/>
                                    <DataGridTextColumn Header="Содержание" Binding="{Binding Text}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- ВКЛАДКА 2: ИСПОЛНИТЕЛИ -->
                    <TabItem Header="СПРАВОЧНИК ИСПОЛНИТЕЛЕЙ" 
                 Visibility="{Binding CurrentUser.Right.Name, Converter={StaticResource RegistrarVisibilityConverter}}">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                                <TextBlock Text="ОТВЕТСТВЕННЫЕ ЛИЦА" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="Список сотрудников, назначенных исполнителями по документам" FontSize="12" Foreground="Gray"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding AllExecutors}" 
                                      Style="{StaticResource MaterialDesignDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HorizontalAlignment="Center"
                                      materialDesign:DataGridAssist.CellPadding="10">   
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ФИО" Binding="{Binding FIO}" Width="*"/>
                                    <DataGridTextColumn Header="Должность" Binding="{Binding Dol}" Width="250"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
