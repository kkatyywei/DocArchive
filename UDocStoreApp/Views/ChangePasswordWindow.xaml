<Window x:Class="UDocStoreApp.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        xmlns:infra="clr-namespace:UDocStoreApp.Infrastructure" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        mc:Ignorable="d"
        Title="Смена пароля" Height="700" Width="1100" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <materialDesign:Card Width="350" Padding="25" 
                             materialDesign:ElevationAssist.Elevation="Dp8" 
                             materialDesign:UniformCornerRadius="15">
            <StackPanel>
                <materialDesign:PackIcon Kind="LockReset" Width="48" Height="48" 
                                         HorizontalAlignment="Center" 
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                <TextBlock Text="СМЕНА ПАРОЛЯ" FontSize="20" FontWeight="ExtraBold" 
                           HorizontalAlignment="Center" Margin="0,10,0,5" 
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                <TextBlock Text="Для продолжения работы необходимо обновить ваш пароль" 
                           FontSize="12" Foreground="Gray" TextAlignment="Center" 
                           TextWrapping="Wrap" Margin="0,0,0,20"/>

                <materialDesign:Card Background="{DynamicResource SecondaryHueLightBrush}" 
                                     Foreground="{DynamicResource SecondaryHueLightForegroundBrush}"
                                     Padding="12" Margin="0,0,0,20"
                                     Visibility="{Binding IsComplexityVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" VerticalAlignment="Center"/>
                            <TextBlock Text="ТРЕБОВАНИЯ К ПАРОЛЮ" FontWeight="Bold" Margin="8,0,0,0" FontSize="11"/>
                        </StackPanel>
                        <TextBlock Text="• Минимум 1 заглавная и 1 строчная буква" FontSize="11"/>
                        <TextBlock Text="• Минимум 1 цифра и 1 спецсимвол" FontSize="11"/>
                        <TextBlock Text="{Binding Policy.MinWidth, StringFormat='• Минимальная длина: {0} знаков'}" FontSize="11"/>
                    </StackPanel>
                </materialDesign:Card>

                <PasswordBox materialDesign:HintAssist.Hint="Новый пароль" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             infra:PasswordHelper.Attach="True" 
                             infra:PasswordHelper.Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" Margin="0,0,0,15"/>

                <PasswordBox materialDesign:HintAssist.Hint="Подтвердите пароль" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                             infra:PasswordHelper.Attach="True" 
                             infra:PasswordHelper.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="45" Margin="0,0,0,10"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}" 
                           FontSize="12" FontWeight="SemiBold" TextAlignment="Center" 
                           TextWrapping="Wrap" Height="40" Margin="0,5"/>

                <Button Content="ОБНОВИТЬ И ВОЙТИ" 
                        Command="{Binding ChangePasswordCommand}" 
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="45" materialDesign:ButtonAssist.CornerRadius="10"
                        materialDesign:ElevationAssist.Elevation="Dp2"/>

                <Button Content="ОТМЕНА" IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="0,10,0,0" Foreground="Gray"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
