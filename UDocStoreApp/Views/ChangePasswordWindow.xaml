<Window x:Class="UDocStoreApp.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UDocStoreApp.Views"
        xmlns:infra="clr-namespace:UDocStoreApp.Infrastructure" 
        mc:Ignorable="d"
        Title="Смена пароля" Height="300" Width="350" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Требуется смена пароля" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Новый пароль:"/>
            <PasswordBox Height="30" Margin="0,5,0,10" 
                         infra:PasswordHelper.Attach="True" 
                         infra:PasswordHelper.Password="{Binding NewPassword, Mode=TwoWay}"/>

            <TextBlock Text="Подтвердите пароль:"/>
            <PasswordBox Height="30" Margin="0,5,0,10" 
                         infra:PasswordHelper.Attach="True" 
                         infra:PasswordHelper.Password="{Binding ConfirmPassword, Mode=TwoWay}"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,5" Height="40"/>

            <Button Content="Сменить и войти" Command="{Binding ChangePasswordCommand}" 
                    Height="35" Background="#10B981" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
